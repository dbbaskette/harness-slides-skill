{
  "name": "harness-slides",
  "version": "0.6.0",
  "description": "Brand-neutral editable slide authoring, preservation and visual review for agent harnesses.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "harness-slides": "scripts/harness-slides.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "context:update": "node tools/context-usage.mjs --write",
    "context:check": "node tools/context-usage.mjs --check",
    "install:skill": "node scripts/install.mjs",
    "ci:local": "bash scripts/ci/tart-macos.sh"
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "image-size": "2.0.4",
    "pptx-automizer": "0.9.4",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "js-tiktoken": "1.0.21",
    "playwright": "1.58.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
